{
  "manifest_version": 3,
  "name": "StudyFlow",
  "version": "1.1.0",
  "description": "Reports Chrome activity to StudyFlow and controls YouTube lecture playback state.",
  "permissions": ["tabs", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {"default_title": "StudyFlow"}
}
